{$SITE_DOMAIN:localhost} {
	# Для "localhost" или голого IP Caddy автоматически не пытается получить
	# настоящий сертификат (это невозможно для не-публичных имён) и просто
	# отдаёт обычный HTTP. Для настоящего домена (например, ваш DDNS-адрес)
	# Caddy сам получает и продлевает сертификат Let's Encrypt — никаких
	# дополнительных действий не требуется.
	reverse_proxy frontend:80
}
