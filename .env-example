# Database configuration
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener
# Внешний порт PostgreSQL. Установите 0, чтобы БД не была доступна снаружи сервера
# (рекомендуется для production — приложению доступ к БД не нужен извне,
# оно всегда обращается к ней внутри docker-сети по имени сервиса "postgres").
POSTGRES_PORT=5432

# Backend configuration
BACKEND_PORT=8080

# --- HTTPS / домен ---
# SITE_DOMAIN — домен, на котором открывается сайт. Если указать настоящий,
# публично резолвящийся домен (например, ваш DDNS-адрес), Caddy (см. caddy/Caddyfile)
# САМ автоматически получит и будет продлевать бесплатный HTTPS-сертификат
# Let's Encrypt — ничего дополнительно настраивать не нужно. Порты 80 и 443
# должны быть доступны из интернета (открыты в firewall/пробросе роутера).
#   Локально (без HTTPS):  SITE_DOMAIN=localhost
#   На сервере:            SITE_DOMAIN=yourdomain.com
SITE_DOMAIN=localhost

# BASE_URL — публичный адрес САЙТА (не бэкенда), используется только чтобы
# сформировать текст короткой ссылки в ответе API. Должен соответствовать
# SITE_DOMAIN и протоколу (http для localhost, https для настоящего домена).
#   Локально:  http://localhost
#   На сервере: https://yourdomain.com  (без слэша на конце!)
BASE_URL=http://localhost

# Application mode (development or production)
APP_ENV=production
