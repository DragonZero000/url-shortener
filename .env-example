# Database configuration
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener
# Внешний порт PostgreSQL. Установите 0, чтобы БД не была доступна снаружи сервера
# (рекомендуется для production — приложению доступ к БД не нужен извне,
# оно всегда обращается к ней внутри docker-сети по имени сервиса "postgres").
POSTGRES_PORT=5432

# Backend configuration
BACKEND_PORT=8080
# BASE_URL — это ПУБЛИЧНЫЙ адрес, на котором открывается сайт (то есть фронтенд),
# а НЕ адрес бэкенда. Он используется только для того, чтобы сформировать
# итоговый текст короткой ссылки в ответе API. Короткие ссылки проксируются
# через nginx (см. frontend/nginx.conf), поэтому значение должно совпадать
# с тем, что вы вводите в адресной строке браузера.
#   Локально:     http://localhost
#   На сервере:   http://<IP-адрес-сервера> (или ваш домен)
# ВАЖНО: без реального HTTPS (сертификата) не указывайте здесь https:// —
# в проекте по умолчанию настроен только обычный http на порту 80.
BASE_URL=http://localhost

# Frontend configuration
FRONTEND_PORT=80

# Application mode (development or production)
APP_ENV=production
